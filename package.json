{
  "name": "dotgrain",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm registry:build && node scripts/og.ts && next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "node scripts/build-registry.ts && shadcn build",
    "test": "vitest run --passWithNoTests",
    "test:visual": "scripts/visual.sh",
    "test:install": "scripts/e2e-install.sh",
    "size": "node scripts/check-size.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "packageManager": "pnpm@10.12.1",
  "type": "module"
}
