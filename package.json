{
  "name": "ditherui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm registry:build && next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "shadcn build",
    "test": "vitest run --passWithNoTests",
    "test:visual": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.12.1"
