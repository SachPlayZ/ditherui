{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotgrain",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild keep_names injects `__name` calls into inline scripts (theme init), which throw in the browser.
  "keep_names": false,
  // /r/* runs the Worker first so each registry install is counted (worker/index.ts).
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": ["/r/*"] },
  "analytics_engine_datasets": [{ "binding": "REGISTRY_REQUESTS", "dataset": "dotgrain_registry" }],
  "workers_dev": false,
  "routes": [
    { "pattern": "dotgrain.space", "custom_domain": true },
    { "pattern": "www.dotgrain.space/*", "zone_name": "dotgrain.space" }
  ]
}
