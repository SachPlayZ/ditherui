{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotgrain",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild keep_names injects `__name` calls into inline scripts (theme init), which throw in the browser.
  "keep_names": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "routes": [
    { "pattern": "dotgrain.space", "custom_domain": true },
    { "pattern": "www.dotgrain.space/*", "zone_name": "dotgrain.space" }
  ]
}
